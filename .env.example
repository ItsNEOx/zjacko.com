# ------------------------------------------------------------------
# Copy this file to .env and fill in your real values:
#     Windows:   copy .env.example .env
#     macOS/Linux: cp .env.example .env
#
# NEVER upload .env anywhere public. Your existing .htaccess already
# blocks dotfile downloads on Apache hosts; the Express server also
# refuses to serve any dotfile. Treat this file like a password.
# ------------------------------------------------------------------

# --- Server -------------------------------------------------------
# Port the Express server listens on.
PORT=3000

# Set to 1 ONLY if you run this server behind a reverse proxy (nginx,
# cPanel, etc.) so client IPs are read from X-Forwarded-For correctly.
# TRUST_PROXY=0

# --- LinkedIn OAuth — the one-click Connect flow (recommended) -----
# Create an app at https://www.linkedin.com/developers/apps (apps must
# be attached to a LinkedIn Page you administer), then:
#
#   1. "Products" tab → add "Sign In with LinkedIn using OpenID
#      Connect" (granted instantly — your live name + photo).
#   2. "Products" tab → also request "Community Management API" —
#      reading your own posts needs its r_member_social scope, which
#      is RESTRICTED: LinkedIn reviews and must approve it. Until
#      they do, only the profile part works (the feed shows its
#      fallback state).
#   3. "Auth" tab → add a Redirect URL:
#         https://zjacko.com/api/linkedin/callback
#   4. "Auth" tab → copy the Client ID and Client Secret here.
#
# Then start the server and open /connect.html once — enter the owner
# key below, click Connect LinkedIn, log in, click Allow. Done. The
# token is stored server-side in private/ (never served, gitignored),
# the author URN is discovered automatically, and renewing after the
# 60-day expiry is another single click.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# A password only YOU know, required on /connect.html for both Connect
# and Disconnect — so nobody else can point your feed at their own
# LinkedIn account. Make it long and random.
LINKEDIN_ADMIN_KEY=

# Where LinkedIn sends you back after clicking "Allow". Leave unset to
# derive it from the request (fine for local testing). In production
# set it to the EXACT URL registered in your LinkedIn app:
# LINKEDIN_REDIRECT_URI=https://zjacko.com/api/linkedin/callback

# Scopes requested during Connect (space separated). The default asks
# for everything the feed needs. While your app is still waiting for
# Community Management API approval you can connect profile-only with
# LINKEDIN_SCOPES=openid profile — then set it back once approved and
# click Connect again.
# LINKEDIN_SCOPES=r_member_social openid profile

# --- LinkedIn manual token (fallback — optional) -------------------
# Alternative to the Connect button: mint a token yourself with the
# OAuth token generator at
# https://www.linkedin.com/developers/tools/oauth/token-generator
# and find your member id in the "sub" field of:
#   curl.exe -H "Authorization: Bearer YOUR_TOKEN" https://api.linkedin.com/v2/userinfo
# then set:
# LINKEDIN_ACCESS_TOKEN=your_oauth_2_access_token
# LINKEDIN_AUTHOR_URN=urn:li:person:your_member_id_here
# NOTE: member tokens EXPIRE AFTER 60 DAYS, and a token stored by the
# Connect flow takes precedence over these values.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=

# LinkedIn-Version header (YYYYMM). Keep reasonably current — see
# https://learn.microsoft.com/linkedin/marketing/
LINKEDIN_API_VERSION=202601

# --- Feed options --------------------------------------------------
# How many posts to fetch from LinkedIn (1-50).
# FEED_COUNT=10

# Seconds to cache LinkedIn's response in memory so page views don't
# hammer the API (default 900 = 15 minutes). 0 disables caching.
# FEED_CACHE_SECONDS=900

# Seconds to cache your name + profile picture from LinkedIn userinfo
# (default 3600 = 1 hour).
# PROFILE_CACHE_SECONDS=3600

# 1 (default) = only posts with PUBLIC visibility are shown. Recommended:
# the website is public, so connection-only posts stay private.
# Set to 0 to include connection-only posts too.
# FEED_PUBLIC_ONLY=1

# --- Cross-origin access -------------------------------------------
# Leave UNSET for same-origin only (the default, most secure).
# Only needed if the site and this API live on different origins,
# e.g. CORS_ORIGIN=https://zjacko.com
# CORS_ORIGIN=
